# Publish only reviewed source files. Private workspace content is excluded by default.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README.en.md
!/LICENSE
!/SECURITY.md
!/CONTRIBUTING.md
!/CHANGELOG.md
!/THIRD_PARTY_NOTICES.md
!/requirements.txt
!/requirements-dev.txt
!/config.example.yaml
!/run.sh
!/app/
!/tests/
!/scripts/
!/tools/
!/docs/
!/examples/
!/.github/
/docs/*
!/docs/open-source/
/tools/*
!/tools/background_service.py
**/__pycache__/
*.py[cod]
.DS_Store
.env
.env.*
!/.env.example
*.sqlite*
*.db
*.pem
*.key
*.log
*.zip
*.pdf

!/RELEASE_MANIFEST.txt

!/android/
android/**/build/
android/.gradle/
android/local.properties
*.jks
*.keystore

!/deployment/
reader-data/
